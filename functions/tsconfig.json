{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2020"],
    "strict": true,
    "noImplicitAny": true,
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": ["./**/*.ts", "../types/**/*.ts"],
  "exclude": ["node_modules", "lib"]
}
