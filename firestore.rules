rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Any authenticated user can read any profile (needed for username uniqueness checks)
      allow read: if request.auth != null;
      // Only the owner can write their own document
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /conversations/{conversationId} {
      // List queries: allow any authenticated user to query — the client-side
      // where('participants','array-contains', uid) constraint scopes results.
      // Get (single doc): enforce that the caller is a participant.
      allow list: if request.auth != null;
      allow get: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        // Only participants of the parent conversation can read/write messages
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
