rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function rideRequestData(requestId) {
      return get(/databases/$(database)/documents/rideRequests/$(requestId)).data;
    }

    match /users/{userId} {
      // Any authenticated user can read any profile (needed for username uniqueness checks)
      allow read: if request.auth != null;
      // Only the owner can write their own document
      allow write: if request.auth != null && request.auth.uid == userId;

      match /historyBlocks/{blockId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        // Owner writes their own history
        allow create: if request.auth != null && request.auth.uid == userId;

        // completeRide writes the counterpart's doc too (same rideRequestId, role/userId aligned)
        allow create: if request.auth != null
          && request.auth.uid != userId
          && request.resource.data.rideRequestId is string
          && request.resource.data.rideRequestId.size() > 0
          && exists(/databases/$(database)/documents/rideRequests/$(request.resource.data.rideRequestId))
          && (
            request.auth.uid == rideRequestData(request.resource.data.rideRequestId).driverId
            || request.auth.uid == rideRequestData(request.resource.data.rideRequestId).riderId
          )
          && (
            userId == rideRequestData(request.resource.data.rideRequestId).driverId
            || userId == rideRequestData(request.resource.data.rideRequestId).riderId
          )
          && (
            (
              request.resource.data.role == 'driver'
              && userId == rideRequestData(request.resource.data.rideRequestId).driverId
            )
            || (
              request.resource.data.role == 'rider'
              && userId == rideRequestData(request.resource.data.rideRequestId).riderId
            )
          )
          && (
            (userId == rideRequestData(request.resource.data.rideRequestId).driverId
             && request.resource.data.otherUserId == rideRequestData(request.resource.data.rideRequestId).riderId)
            || (userId == rideRequestData(request.resource.data.rideRequestId).riderId
                && request.resource.data.otherUserId == rideRequestData(request.resource.data.rideRequestId).driverId)
          );

        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /conversations/{conversationId} {
      // List queries: allow any authenticated user to query — the client-side
      // where('participants','array-contains', uid) constraint scopes results.
      // Get (single doc): enforce that the caller is a participant.
      allow list: if request.auth != null;
      allow get: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        // Only participants of the parent conversation can read/write messages
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /scheduleBlocks/{blockId} {
      // Any authenticated user can read schedule blocks (e.g. to view a driver's availability)
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;

      // Owners may update freely; rider OR driver cancelling a booked ride needs to reopen the block.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || (
          resource.data.status == 'booked'
          && request.resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );
    }

    match /rideRequests/{requestId} {
      // List queries are scoped by the client with where('driverId'/'riderId', '==', uid)
      allow list: if request.auth != null;
      // Single-doc get enforces participant check
      allow get: if request.auth != null
        && (request.auth.uid == resource.data.driverId
            || request.auth.uid == resource.data.riderId);
      // Either the rider OR the driver can create a ride request
      // (drivers initiate when they offer to drive a specific rider ride)
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.riderId
            || request.auth.uid == request.resource.data.driverId);
      // Either party can update (accept, deny, cancel)
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.driverId
            || request.auth.uid == resource.data.riderId);
    }

    match /rideConfirmations/{confirmationId} {
      // List queries are scoped by the client
      allow list: if request.auth != null;
      allow get: if request.auth != null
        && (request.auth.uid == resource.data.driverId
            || request.auth.uid == resource.data.riderId);
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.driverId
            || request.auth.uid == request.resource.data.riderId);
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.driverId
            || request.auth.uid == resource.data.riderId);
      // Either party can delete when cancelling a ride
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.driverId
            || request.auth.uid == resource.data.riderId);
    }

    match /ratings/{ratingId} {
      allow list: if request.auth != null;
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUserId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.fromUserId;
    }

    match /riderRides/{rideId} {
      // Only the owning rider can read, create, or delete their rides
      allow list: if request.auth != null;
      allow get: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    match /notifications/{notificationId} {
      // List queries are scoped by the client with where('userId', '==', uid)
      allow list: if request.auth != null;
      allow get: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
